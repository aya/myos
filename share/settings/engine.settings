# The defaults of the engine, in the language of the stacks (see
# lib/settings.awk). A stack or the user may override any of them.

# where an application is served: <prefix><app>.<domain>, the prefix holding
# the environment when it is not a main one and the user when several users
# share a host; a host stack serves <hostname>.<domain> (and <domain> when it
# is the load balancer)
APP_HOST_MULTI_APP  ?= false
APP_HOST_MULTI_ENV  ?= @if(@filter-out(local master main,${ENV}),true)
APP_HOST_MULTI_USER ?= false
APP_DOMAIN_PREFIX   ?= @if(${HOST_STACK},,@if(@filter(true,${APP_HOST_MULTI_USER}),${USER}.))
APP_DOMAIN          ?= @patsubst(%,${APP_DOMAIN_PREFIX}%,${DOMAIN})
APP_HOST_PREFIX     ?= @addsuffix(.,@if(${HOST_STACK},${HOSTNAME},@if(@filter(true,${APP_HOST_MULTI_ENV}),${ENV})))
APP_HOST            ?= @patsubst(%,${APP_HOST_PREFIX}%,@if(@filter(true,${APP_HOST_MULTI_APP}),${APP_NAME}.)${APP_DOMAIN})@if(${HOST_STACK},@if(${HOST_LB},${space}${DOMAIN}))
APP_PATH            ?=
APP_SCHEME          ?= http
APP_URI             ?= @patsubst(%,%/${APP_PATH},${APP_HOST})
APP_URL             ?= @patsubst(%,${APP_SCHEME}://%,${APP_URI})
HOST                ?= @patsubst(%,${HOSTNAME}.%,${DOMAIN})
HOST_LB             ?=
USER_LB             ?=
GIT_USER            ?= ${USER}
MACHINE             ?= !shell(uname -m)
HOST_UID            ?= 123
HOST_DOCKER_VOLUME     ?= ${HOST_COMPOSE_PROJECT_NAME}
HOST_DOCKER_REPOSITORY ?= @subst(-,/,@subst(_,/,${HOST_COMPOSE_PROJECT_NAME}))
USER_DOCKER_VOLUME     ?= ${USER_COMPOSE_PROJECT_NAME}

# where a published port listens: a stack writes
# "${MYOS_BIND_PRIVATE:-127.0.0.1}:8080:80" for a port of the host only,
# ${MYOS_BIND_MESH} for the overlay network, ${MYOS_BIND_PUBLIC} (host
# stacks only) for the world
MYOS_BIND_PUBLIC  ?= 0.0.0.0
MYOS_BIND_PRIVATE ?= 127.0.0.1
MYOS_BIND_MESH    ?=

# which router reads the routes a stack declares: fabio (the consul tags of
# @tagprefix) or traefik (the rule of @traefikrule). The declaration is the
# same either way, so this is a choice of the host stack, not of the stacks it
# serves. TRAEFIK_ENABLE is the label that makes the other one inert.
# le builder demandé à compose : BuildKit, le défaut de docker et le seul qui
# lise `RUN --mount=`. `DOCKER_BUILDKIT=0` rend le builder hérité.
DOCKER_BUILDKIT ?= 1

MYOS_ROUTER    ?= fabio
TRAEFIK_ENABLE ?= @if(@filter(traefik,${MYOS_ROUTER}),true,false)
