#!/bin/sh
# myos: entry point. Resolves the installation directory (through symlinks),
# loads the system configuration and runs the engine (lib/main.sh).
# just is the interface for humans and agents (justfile, `just --list`) and
# the format of the hooks a stack ships; the engine itself is POSIX sh, so a
# host without just works the same.
set -u
MYOS=$0
while [ -L "$MYOS" ]; do
  _link=$(readlink "$MYOS")
  case $_link in /*) MYOS=$_link ;; *) MYOS=$(dirname "$MYOS")/$_link ;; esac
done
MYOS=$(cd "$(dirname "$MYOS")" && pwd -P)
export MYOS
MYOS_CONF=${MYOS_CONF:-/etc/conf.d/myos}
[ -r "$MYOS_CONF" ] || MYOS_CONF=/etc/default/myos
# installed without root, a user has no /etc to write to: install.sh --conf
# writes here instead, and it stands for the machine only when the machine
# says nothing itself
[ -r "$MYOS_CONF" ] || MYOS_CONF=${XDG_CONFIG_HOME:-${HOME:-}/.config}/myos/config
if [ -r "$MYOS_CONF" ]; then
  # KEY=VALUE lines of the system configuration become defaults of the
  # environment: what the environment already holds wins. It is exported
  # because its job is to point the docker CLI somewhere (DOCKER_HOST,
  # DOCKER_SOCKET_LOCATION), and a child process reads only the environment.
  # Each one is also marked in MYOS_CONF_<name> so the engine can tell it apart
  # from a variable the operator set: the machine's default is a fallback and
  # must lose to the .env of a project, which is more specific than the host it
  # is driven from.
  while IFS= read -r _line || [ -n "$_line" ]; do
    case $_line in ''|'#'*|*[!A-Za-z0-9_=]*=*|*=*) ;; *) continue ;; esac
    case $_line in ''|'#'*) continue ;; esac
    _k=${_line%%=*}; _v=${_line#*=}
    case $_k in *[!A-Za-z0-9_]*|'') continue ;; esac
    eval "[ -n \"\${$_k+set}\" ] || { $_k=\$_v; export $_k; MYOS_CONF_$_k=\$_v; export MYOS_CONF_$_k; }"
  done < "$MYOS_CONF"
fi
exec sh "$MYOS/lib/main.sh" "$@"
