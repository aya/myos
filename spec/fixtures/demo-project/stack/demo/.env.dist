# a fixed value, a reference to the environment, a reference to another key
# and a command substitution: what a stack developer writes so that the user
# only has to run `myos up`
DEMO_TITLE=demo
DEMO_HOST=demo.${DOMAIN}
DEMO_URL=https://${DEMO_HOST}/
DEMO_SECRET=$(echo fixed-secret-for-tests | tr a-z A-Z)
