:80 {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Credentials true
        Access-Control-Allow-Methods "*"
        Access-Control-Allow-Headers "*"
        defer
    }

    encode zstd gzip
    reverse_proxy whisper-frontend:5173
    
    handle_path /api/* {
        reverse_proxy whisper-backend:3000
    }

}
